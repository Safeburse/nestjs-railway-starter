# Required. Postgres 14+ connection string (Railway, local, or any host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oriva_asset

# Optional. Defaults to 8080.
PORT=8080

# S3-compatible object store. Used by later stories (documents, reports).
# No vendor SDK in domain modules — set these when the documents story lands.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
